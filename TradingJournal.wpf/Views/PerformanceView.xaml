<UserControl x:Class="TradingJournal.wpf.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             Background="#F0F4F8">

    <UserControl.Resources>
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Width" Value="160"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sidhuvud -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1"
                Padding="28,20">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Performance"
                               Foreground="#0F172A"
                               FontSize="20"
                               FontWeight="Bold"/>
                    <TextBlock Text="Utvärdera din handelsstrategi"
                               Foreground="#94A3B8"
                               FontSize="12"
                               Margin="0,3,0,0"/>
                </StackPanel>
                <Button Content="↻  Uppdatera"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryBtn}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Height="36"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">

                <!-- ── Nyckeltal ── -->
                <TextBlock Text="NYCKELTAL"
                           Style="{StaticResource SectionLabel}"/>

                <WrapPanel Margin="0,0,0,8">

                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="ANTAL TRADES"
                                       Foreground="#94A3B8"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding TotalTrades}"
                                       Foreground="#0F172A"
                                       FontSize="28"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="TOTAL PNL"
                                       Foreground="#94A3B8"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding TotalPnL, StringFormat=${0:N2}}"
                                       FontSize="28"
                                       FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#059669"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TotalPnL,
                                                Converter={StaticResource IsNegativeConverter}}"
                                                Value="True">
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="WIN RATE"
                                       Foreground="#94A3B8"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding WinRate, StringFormat={}{0:N1}%}"
                                       Foreground="#0F172A"
                                       FontSize="28"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="EXPECTANCY"
                                       Foreground="#94A3B8"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Expectancy, StringFormat=${0:N2}}"
                                       Foreground="#0F172A"
                                       FontSize="28"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="WIN/LOSS RATIO"
                                       Foreground="#94A3B8"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding WinLossRatio, StringFormat={}{0:N2}}"
                                       Foreground="#0F172A"
                                       FontSize="28"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="MAX DRAWDOWN"
                                       Foreground="#94A3B8"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding MaxDrawdown, StringFormat={}{0:N4}%}"
                                       Foreground="#DC2626"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="PEAK EQUITY"
                                       Foreground="#94A3B8"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding PeakEquity, StringFormat=${0:N2}}"
                                       Foreground="#059669"
                                       FontSize="22"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="LOWEST EQUITY"
                                       Foreground="#94A3B8"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding LowestEquity, StringFormat=${0:N2}}"
                                       Foreground="#D97706"
                                       FontSize="22"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="CONS. WINS"
                                       Foreground="#94A3B8"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding ConsecutiveWins}"
                                       Foreground="#059669"
                                       FontSize="28"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="CONS. LOSSES"
                                       Foreground="#94A3B8"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding ConsecutiveLosses}"
                                       Foreground="#DC2626"
                                       FontSize="28"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                </WrapPanel>

                <!-- ── Equity curve ── -->
                <TextBlock Text="EQUITY CURVE"
                           Style="{StaticResource SectionLabel}"
                           Margin="0,8,0,12"/>

                <Border Background="#FFFFFF"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16"
                        Height="340">
                    <oxy:PlotView Model="{Binding PlotModel}"
                                  Background="Transparent"/>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
<UserControl x:Class="TradingJournal.wpf.Views.PositionCalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E2E">

    <UserControl.Resources>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- SelectAll på GotFocus tar bort nollan automatiskt -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <EventSetter Event="GotKeyboardFocus" Handler="TextBox_GotKeyboardFocus"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TextBox_PreviewMouseLeftButtonDown"/>
        </Style>

        <Style x:Key="ResultLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ResultValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A6E3A1"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Vänster: Indata ── -->
            <StackPanel Grid.Column="0">

                <TextBlock Text="Position Size Calculator"
                           Foreground="#CDD6F4"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <Border Background="#181825"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel>

                        <TextBlock Text="Kontouppgifter"
                                   Foreground="#89B4FA"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Kapital ($)" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Capital, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="Risk per trade (%)" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding RiskPercent, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="Hävstång (x)" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Leverage, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="Prisuppgifter"
                                   Foreground="#89B4FA"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,16,0,16"/>

                        <TextBlock Text="Entry" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Entry, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="Stop Loss" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding StopLoss, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource InputStyle}"/>

                        <TextBlock Text="Take Profit" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding TakeProfit, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource InputStyle}"/>

                        <!-- Felmeddelande -->
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#F38BA8"
                                   FontSize="12"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding ErrorMessage,
                                       Converter={StaticResource StringToVisibilityConverter}}"/>

                        <!-- Knappar -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="🧮  Räkna"
                                Command="{Binding CalculateCommand}"
                                Background="#89B4FA"
                                Foreground="#1E1E2E"
                                BorderThickness="0"
                                Padding="20,10"
                                FontSize="13"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Margin="0,0,8,0"/>
                        <Button Content="🔄  Återställ"
                                Command="{Binding ResetCommand}"
                                Background="#45475A"
                                Foreground="#CDD6F4"
                                BorderThickness="0"
                                Padding="16,10"
                                FontSize="13"
                                Cursor="Hand"/>
                        </StackPanel>

                        
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ── Höger: Resultat ── -->
            <StackPanel Grid.Column="2">

                <TextBlock Text="Resultat"
                           Foreground="#CDD6F4"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <Border Background="#181825"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel>

                        <TextBlock Text="Total risk"
                                   Style="{StaticResource ResultLabelStyle}"/>
                        <TextBlock Text="{Binding TotalRisk, StringFormat=${0:N2}}"
                                   Style="{StaticResource ResultValueStyle}"/>

                        <TextBlock Text="Antal enheter (Amount)"
                                   Style="{StaticResource ResultLabelStyle}"/>
                        <TextBlock Text="{Binding Amount, StringFormat={}{0:N8}}"
                                   Style="{StaticResource ResultValueStyle}"/>

                        <TextBlock Text="Nominell position size"
                                   Style="{StaticResource ResultLabelStyle}"/>
                        <TextBlock Text="{Binding NominalPositionSize, StringFormat=${0:N2}}"
                                   Style="{StaticResource ResultValueStyle}"/>

                        <Border Background="#313244"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Final position size"
                                           Foreground="#89B4FA"
                                           FontSize="13"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding FinalPositionSize, StringFormat=${0:N2}}"
                                           Foreground="#A6E3A1"
                                           FontSize="32"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Risk/Reward (R/R)"
                                   Style="{StaticResource ResultLabelStyle}"/>
                        <TextBlock Text="{Binding RR, StringFormat={}{0:N2} RR}"
                                   Style="{StaticResource ResultValueStyle}"/>

                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
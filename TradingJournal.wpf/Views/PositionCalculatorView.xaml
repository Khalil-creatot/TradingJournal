<UserControl x:Class="TradingJournal.wpf.Views.PositionCalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F4F8">

    <UserControl.Resources>
        <Style x:Key="ResultCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sidhuvud -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1"
                Padding="28,20">
            <StackPanel>
                <TextBlock Text="Position Size Calculator"
                           Foreground="#0F172A"
                           FontSize="20"
                           FontWeight="Bold"/>
                <TextBlock Text="Beräkna optimal position size baserat på din riskprofil"
                           Foreground="#94A3B8"
                           FontSize="12"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Innehåll -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Vänster: Indata ── -->
                <StackPanel Grid.Column="0">

                    <!-- Konto -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="KONTO"
                                       Style="{StaticResource SectionLabel}"/>

                            <TextBlock Text="Kapital ($)" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Capital, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource InputStyle}"
                                     Height="38"
                                     Margin="0,0,0,14"/>

                            <TextBlock Text="Risk per trade (%)" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding RiskPercent, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource InputStyle}"
                                     Height="38"
                                     Margin="0,0,0,14"/>

                            <TextBlock Text="Hävstång (x)" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Leverage, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource InputStyle}"
                                     Height="38"/>
                        </StackPanel>
                    </Border>

                    <!-- Priser -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="PRISER"
                                       Style="{StaticResource SectionLabel}"/>

                            <TextBlock Text="Entry" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Entry, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource InputStyle}"
                                     Height="38"
                                     Margin="0,0,0,14"/>

                            <TextBlock Text="Stop Loss" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding StopLoss, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource InputStyle}"
                                     Height="38"
                                     Margin="0,0,0,14"/>

                            <TextBlock Text="Take Profit" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding TakeProfit, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource InputStyle}"
                                     Height="38"/>
                        </StackPanel>
                    </Border>

                    <!-- Felmeddelande -->
                    <Border Background="#FEF2F2"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,0,0,12"
                            Visibility="{Binding ErrorMessage,
                                Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#DC2626"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Knappar -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="Beräkna"
                                Command="{Binding CalculateCommand}"
                                Style="{StaticResource PrimaryBtn}"
                                Height="42"/>
                        <Button Grid.Column="2"
                                Content="Rensa"
                                Command="{Binding ResetCommand}"
                                Style="{StaticResource SecondaryBtn}"
                                Height="42"/>
                    </Grid>
                </StackPanel>

                <!-- ── Höger: Resultat ── -->
                <StackPanel Grid.Column="2">

                    <TextBlock Text="RESULTAT"
                               Style="{StaticResource SectionLabel}"/>

                    <!-- Final position size – framhävd -->
                    <Border Background="#EFF6FF"
                            BorderBrush="#2563EB"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="24"
                            Margin="0,0,0,16">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="FINAL POSITION SIZE"
                                           Foreground="#2563EB"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding FinalPositionSize, StringFormat=${0:N2}}"
                                           Foreground="#1D4ED8"
                                           FontSize="44"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Det kapital du faktiskt behöver lägga upp"
                                           Foreground="#3B82F6"
                                           FontSize="12"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Resultatgrid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Total risk -->
                        <Border Grid.Row="0" Grid.Column="0"
                                Background="#FEF2F2"
                                BorderBrush="#FECACA"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="20"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="TOTAL RISK"
                                           Foreground="#DC2626"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding TotalRisk, StringFormat=${0:N2}}"
                                           Foreground="#DC2626"
                                           FontSize="28"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Max förlust i dollar"
                                           Foreground="#F87171"
                                           FontSize="11"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- R/R -->
                        <Border Grid.Row="0" Grid.Column="2"
                                Background="#ECFDF5"
                                BorderBrush="#BBF7D0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="20"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="RISK / REWARD"
                                           Foreground="#059669"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding RR, StringFormat={}{0:N2}R}"
                                           Foreground="#059669"
                                           FontSize="28"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Potential vinst vs risk"
                                           Foreground="#34D399"
                                           FontSize="11"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Amount -->
                        <Border Grid.Row="1" Grid.Column="0"
                                Style="{StaticResource ResultCardStyle}">
                            <StackPanel>
                                <TextBlock Text="AMOUNT"
                                           Foreground="#94A3B8"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding Amount, StringFormat={}{0:N8}}"
                                           Foreground="#0F172A"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Antal enheter att handla"
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Nominell PS -->
                        <Border Grid.Row="1" Grid.Column="2"
                                Style="{StaticResource ResultCardStyle}">
                            <StackPanel>
                                <TextBlock Text="NOMINELL POSITION"
                                           Foreground="#94A3B8"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding NominalPositionSize, StringFormat=${0:N2}}"
                                           Foreground="#0F172A"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Totalt värde före hävstång"
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>